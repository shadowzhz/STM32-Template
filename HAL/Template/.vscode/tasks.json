{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Build",
      "type": "process",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "STM32: Flash",
      "type": "process",
      "command": "make",
      "problemMatcher": [],
      "args": [
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "STM32: Clean",
      "type": "process",
      "command": "make",
      "problemMatcher": [],
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
